package leguawings.gui;

import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class VentanaPrincipalGUI extends JFrame {

    private static final long serialVersionUID = 1L;
    private JTextArea txtAreaInfo;

    public VentanaPrincipalGUI() {
        // Configuración de la ventana principal
        setTitle("Legua Wings - Panel Principal");
        setSize(550, 450);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());

        // 1. Panel Superior (Título)
        JLabel lblTitulo = new JLabel("🔥 LEGUA WINGS - SISTEMA DE GESTIÓN 🔥", SwingConstants.CENTER);
        lblTitulo.setFont(new Font("Arial", Font.BOLD, 16));
        lblTitulo.setForeground(new Color(211, 84, 0));
        add(lblTitulo, BorderLayout.NORTH);

        // 2. Panel Central con ScrollPane (JScrollPane)
        txtAreaInfo = new JTextArea();
        txtAreaInfo.setText("Bienvenido al sistema.\nHaz clic en 'Ver Menú' o 'Hacer Pedido Dinámico' para comenzar.");
        txtAreaInfo.setEditable(false);
        txtAreaInfo.setFont(new Font("Monospaced", Font.PLAIN, 12));
        
        JScrollPane scrollPane = new JScrollPane(txtAreaInfo);
        add(scrollPane, BorderLayout.CENTER);

        // 3. Panel Inferior (Botones de Navegación)
        JPanel panelBotones = new JPanel();
        JButton btnVerMenu = new JButton("Ver Menú");
        JButton btnHacerPedido = new JButton("Hacer Pedido Dinámico");

        panelBotones.add(btnVerMenu);
        panelBotones.add(btnHacerPedido);
        add(panelBotones, BorderLayout.SOUTH);

        // Evento para ver el menú
        btnVerMenu.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                txtAreaInfo.setText("=== CARTA OFICIAL LEGUA WINGS ===\n\n" +
                        " [ SALCHIS ]\n" +
                        " - Salchikids: S/ 5.90 (2 alitas, salchipapa pequeña)\n" +
                        " - Salchipapa: S/ 11.90\n" +
                        " - Salchiwings: S/ 16.90 (Salchipapa regular, 4 alitas)\n" +
                        " - Bites: S/ 8.90 (Trozos de pechuga crocantes)\n\n" +
                        " [ COMBOS ]\n" +
                        " - Combo 1: S/ 18.90 (6 alitas + 1 papa regular + 1 crema)\n" +
                        " - Combo 2: S/ 27.90 (12 alitas + 2 papas regulares + 2 cremas)\n" +
                        " - Combo 3: S/ 36.90 (18 alitas + 3 papas regulares + 3 cremas)\n\n" +
                        " [ PROMOCIONES ]\n" +
                        " - 2x1 en Salchis todos los sábados.\n" +
                        " - 5 Compras = 50% OFF en tu próximo combo.");
            }
        });

        // Evento para abrir el JDialog Dinámico de Pedidos
        btnHacerPedido.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                FormularioPedidoDialog dialog = new FormularioPedidoDialog(VentanaPrincipalGUI.this);
                dialog.setVisible(true);
            }
        });
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(new Runnable() {
            @Override
            public void run() {
                new VentanaPrincipalGUI().setVisible(true);
            }
        });
    }
}

// ==========================================
// CLASE PARA LA VENTANA EMERGENTE (JDialog)
// ==========================================
class FormularioPedidoDialog extends JDialog {

    private static final long serialVersionUID = 1L;
    private JTextField txtNombre, txtTelefono;
    private JComboBox<String> cmbPlatos, cmbSalsas;
    private JCheckBox chkPapaGrande, chkQueso, chkChorizo;

    public FormularioPedidoDialog(JFrame parent) {
        super(parent, "Formulario Interactivo de Pedidos - Legua Wings", true);
        setSize(450, 480);
        setLocationRelativeTo(parent);
        setLayout(new GridLayout(9, 2, 10, 10));

        add(new JLabel(" Nombre del Cliente:"));
        txtNombre = new JTextField();
        add(txtNombre);

        add(new JLabel(" Teléfono (Celular):"));
        txtTelefono = new JTextField();
        add(txtTelefono);

        add(new JLabel(" Seleccionar Plato / Combo:"));
        String[] platos = {
            "Salchikids (S/ 5.90)", 
            "Salchipapa (S/ 11.90)", 
            "Salchiwings (S/ 16.90)", 
            "Bites (S/ 8.90)", 
            "Combo 1 (S/ 18.90)", 
            "Combo 2 (S/ 27.90)", 
            "Combo 3 (S/ 36.90)"
        };
        cmbPlatos = new JComboBox<>(platos);
        add(cmbPlatos);

        add(new JLabel(" Sabor / Crema a elección:"));
        String[] salsasCremas = {
            "Mayonesa Vinagreta", "Ají de la Casa", "Chimichurri", 
            "Mostaza", "Ketchup", "BBQ", "BBQ Picante", "Brava", "Acevichada"
        };
        cmbSalsas = new JComboBox<>(salsasCremas);
        add(cmbSalsas);

        add(new JLabel(" Modificar Papa:"));
        chkPapaGrande = new JCheckBox("Convertir a Papa Grande (+S/ 3.00)");
        add(chkPapaGrande);

        add(new JLabel(" Extras opcionales:"));
        chkQueso = new JCheckBox("Queso (+S/ 2.00)");
        add(chkQueso);

        add(new JLabel(" Otro extra:"));
        chkChorizo = new JCheckBox("Chorizo (+S/ 3.00)");
        add(chkChorizo);

        add(new JLabel("")); 
        JButton btnCalcular = new JButton("Procesar y Ver Total");
        btnCalcular.setBackground(new Color(211, 84, 0));
        btnCalcular.setForeground(Color.WHITE);
        add(btnCalcular);

        btnCalcular.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                procesarPedido();
            }
        });
    }

    private void procesarPedido() {
        String nombre = txtNombre.getText().trim();
        String telefono = txtTelefono.getText().trim();

        if (nombre.isEmpty() || telefono.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Por favor completa tu nombre y teléfono.", "Error", JOptionPane.ERROR_MESSAGE);
            return;
        }

        int seleccion = cmbPlatos.getSelectedIndex();
        double precioBase = 0.0;

        switch (seleccion) {
            case 0: precioBase = 5.90; break;
            case 1: precioBase = 11.90; break;
            case 2: precioBase = 16.90; break;
            case 3: precioBase = 8.90; break;
            case 4: precioBase = 18.90; break;
            case 5: precioBase = 27.90; break;
            case 6: precioBase = 36.90; break;
        }

        double total = precioBase;
        if (chkPapaGrande.isSelected()) total += 3.00;
        if (chkQueso.isSelected()) total += 2.00;
        if (chkChorizo.isSelected()) total += 3.00;

        String resumen = "=== PEDIDO REGISTRADO ===\n" +
                "Cliente: " + nombre + "\n" +
                "Celular: " + telefono + "\n" +
                "Plato: " + cmbPlatos.getSelectedItem() + "\n" +
                "Crema/Salsa: " + cmbSalsas.getSelectedItem() + "\n\n" +
                "TOTAL A PAGAR: S/ " + String.format("%.2f", total) + "\n" +
                "(Delivery Gratis - Contacto: 923 883 240)\n Gracias por su preferencia! =)";

        JOptionPane.showMessageDialog(this, resumen, "Resumen de Venta", JOptionPane.INFORMATION_MESSAGE);
        dispose();
    }
}